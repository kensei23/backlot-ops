# --- Google Cloud / Gemini ---
# Your GCP project ID (the one you requested the $100 hackathon credit for)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Tell ADK to use Vertex AI (not the public Gemini API) for auth via gcloud
GOOGLE_GENAI_USE_VERTEXAI=True

# --- Grafana Cloud ---
# Your Grafana Cloud stack URL, e.g. https://yourstackname.grafana.net
GRAFANA_STACK_URL=https://your-stack.grafana.net

# Service account token for the agent's MCP connection (separate from the
# metrics/logs push tokens below). Create via: in your Grafana instance,
# left sidebar -> Administration -> Users and access -> Service accounts
# -> Add service account (give it Editor role) -> Add service account
# token -> copy it here. Starts with glsa_
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your-service-account-token

# --- Grafana Cloud: Metrics (Prometheus) push credentials ---
# From the Prometheus "Details" page. IMPORTANT: only paste the base URL,
# stopping right after ".grafana.net" - drop the "/api/prom/push" part,
# our script adds its own path onto the end of this.
# e.g. https://prometheus-prod-24-prod-us-east-0.grafana.net
GRAFANA_METRICS_URL=https://prometheus-prod-XX-prod-region.grafana.net
GRAFANA_METRICS_USERNAME=your-metrics-username-number
GRAFANA_METRICS_API_KEY=your-metrics-token

# --- Grafana Cloud: Logs (Loki) push credentials ---
# From the Loki "Details" page. Paste the FULL url this time, including
# the /loki/api/v1/push part at the end - don't trim this one.
GRAFANA_LOGS_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_LOGS_USERNAME=your-logs-username-number
GRAFANA_LOGS_API_KEY=your-logs-token
